DATABASE_URL=postgresql://app:change-me@localhost:5432/code_knowledge
JWT_SECRET=replace-with-at-least-32-random-characters
# Development-only example (32 zero bytes). Generate a unique key for every deployment.
DOCUMENT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DAILY_COST_BUDGET_MICROS=10000000
API_RATE_LIMIT=120
ANSWER_MIN_FAITHFULNESS=0.9
ANSWER_MIN_RETRIEVAL_RECALL=0.8
ANSWER_MIN_FRESHNESS=0.8
CORS_ORIGINS=http://localhost:5173
PORT=5001
# GITHUB_API_URL=
# GITHUB_TOKEN=
# OBJECT_STORAGE_URL=
# OBJECT_STORAGE_TOKEN=
# VECTOR_INDEX_URL=
# VECTOR_INDEX_TOKEN=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
